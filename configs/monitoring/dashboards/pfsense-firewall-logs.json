{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "title": "pfSense firewall logs",
  "uid": "pfsense-fw-logs",
  "tags": [
    "pfsense",
    "firewall",
    "loki"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Blocked in zones (selected period)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "sum(count_over_time({job=\"pfsense\"} | regexp \"^(?P<rule>[0-9]*),[^,]*,[^,]*,(?P<tracker>[0-9]*),(?P<iface>[^,]+),(?P<reason>[^,]+),(?P<action>[^,]+),(?P<dir>[^,]+),(?P<ipver>[0-9]),[^,]*,[^,]*,[^,]*,[^,]*,[^,]*,[^,]*,[^,]*,(?P<proto>[a-z0-9]+),[^,]*,(?P<src>[0-9.]+),(?P<dst>[0-9.]+)(?:,(?P<sport>[0-9]+),(?P<dport>[0-9]+))?\" | action=\"block\" | iface=~\"igc1[.].*\" [$__range]))",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "id": 1,
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      }
    },
    {
      "type": "stat",
      "title": "WAN default-deny noise",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "sum(count_over_time({job=\"pfsense\"} | regexp \"^(?P<rule>[0-9]*),[^,]*,[^,]*,(?P<tracker>[0-9]*),(?P<iface>[^,]+),(?P<reason>[^,]+),(?P<action>[^,]+),(?P<dir>[^,]+),(?P<ipver>[0-9]),[^,]*,[^,]*,[^,]*,[^,]*,[^,]*,[^,]*,[^,]*,(?P<proto>[a-z0-9]+),[^,]*,(?P<src>[0-9.]+),(?P<dst>[0-9.]+)(?:,(?P<sport>[0-9]+),(?P<dport>[0-9]+))?\" | action=\"block\" | iface=\"igc0\" [$__range]))",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "id": 2,
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      }
    },
    {
      "type": "text",
      "title": "Interface to zone",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "options": {
        "mode": "markdown",
        "content": "`igc1.10` MGMT  |  `igc1.20` INFRA  |  `igc1.30` DMZ  |  `igc1.40` MONITORING  |  `igc0` WAN\n\nRule `tracker` ids identify the pfSense rule that blocked the packet."
      },
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Blocked packets per zone interface",
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "sum by (iface) (count_over_time({job=\"pfsense\"} | regexp \"^(?P<rule>[0-9]*),[^,]*,[^,]*,(?P<tracker>[0-9]*),(?P<iface>[^,]+),(?P<reason>[^,]+),(?P<action>[^,]+),(?P<dir>[^,]+),(?P<ipver>[0-9]),[^,]*,[^,]*,[^,]*,[^,]*,[^,]*,[^,]*,[^,]*,(?P<proto>[a-z0-9]+),[^,]*,(?P<src>[0-9.]+),(?P<dst>[0-9.]+)(?:,(?P<sport>[0-9]+),(?P<dport>[0-9]+))?\" | action=\"block\" | iface=~\"igc1[.].*\" [$__interval]))",
          "queryType": "range",
          "legendFormat": "{{iface}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 70
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 4,
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      }
    },
    {
      "type": "timeseries",
      "title": "WAN blocks (background noise)",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "sum(count_over_time({job=\"pfsense\"} | regexp \"^(?P<rule>[0-9]*),[^,]*,[^,]*,(?P<tracker>[0-9]*),(?P<iface>[^,]+),(?P<reason>[^,]+),(?P<action>[^,]+),(?P<dir>[^,]+),(?P<ipver>[0-9]),[^,]*,[^,]*,[^,]*,[^,]*,[^,]*,[^,]*,[^,]*,(?P<proto>[a-z0-9]+),[^,]*,(?P<src>[0-9.]+),(?P<dst>[0-9.]+)(?:,(?P<sport>[0-9]+),(?P<dport>[0-9]+))?\" | action=\"block\" | iface=\"igc0\" [$__interval]))",
          "queryType": "range",
          "legendFormat": "igc0"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15
          },
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "hidden"
        }
      },
      "id": 5,
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      }
    },
    {
      "type": "table",
      "title": "Top rules that blocked (zones)",
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "topk(10, sum by (iface, rule, tracker) (count_over_time({job=\"pfsense\"} | regexp \"^(?P<rule>[0-9]*),[^,]*,[^,]*,(?P<tracker>[0-9]*),(?P<iface>[^,]+),(?P<reason>[^,]+),(?P<action>[^,]+),(?P<dir>[^,]+),(?P<ipver>[0-9]),[^,]*,[^,]*,[^,]*,[^,]*,[^,]*,[^,]*,[^,]*,(?P<proto>[a-z0-9]+),[^,]*,(?P<src>[0-9.]+),(?P<dst>[0-9.]+)(?:,(?P<sport>[0-9]+),(?P<dport>[0-9]+))?\" | action=\"block\" | iface=~\"igc1[.].*\" [$__range])))",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "blocks"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "blocks",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true
      },
      "id": 6,
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      }
    },
    {
      "type": "table",
      "title": "Top blocked flows (source, destination, port)",
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 10,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "topk(15, sum by (iface, src, dst, proto, dport) (count_over_time({job=\"pfsense\"} | regexp \"^(?P<rule>[0-9]*),[^,]*,[^,]*,(?P<tracker>[0-9]*),(?P<iface>[^,]+),(?P<reason>[^,]+),(?P<action>[^,]+),(?P<dir>[^,]+),(?P<ipver>[0-9]),[^,]*,[^,]*,[^,]*,[^,]*,[^,]*,[^,]*,[^,]*,(?P<proto>[a-z0-9]+),[^,]*,(?P<src>[0-9.]+),(?P<dst>[0-9.]+)(?:,(?P<sport>[0-9]+),(?P<dport>[0-9]+))?\" | action=\"block\" | iface=~\"igc1[.].*\" [$__range])))",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "blocks"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "blocks",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true
      },
      "id": 7,
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      }
    },
    {
      "type": "logs",
      "title": "Latest zone blocks",
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "queryType": "range",
          "expr": "{job=\"pfsense\"} | regexp \"^(?P<rule>[0-9]*),[^,]*,[^,]*,(?P<tracker>[0-9]*),(?P<iface>[^,]+),(?P<reason>[^,]+),(?P<action>[^,]+),(?P<dir>[^,]+),(?P<ipver>[0-9]),[^,]*,[^,]*,[^,]*,[^,]*,[^,]*,[^,]*,[^,]*,(?P<proto>[a-z0-9]+),[^,]*,(?P<src>[0-9.]+),(?P<dst>[0-9.]+)(?:,(?P<sport>[0-9]+),(?P<dport>[0-9]+))?\" | action=\"block\" | iface=~\"igc1[.].*\" | line_format \"{{.iface}}  {{.src}} -> {{.dst}}:{{.dport}}  {{.proto}}  rule {{.rule}}\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "id": 8,
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      }
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}