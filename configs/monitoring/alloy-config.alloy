loki.source.syslog "pfsense" {
  listener {
    address                = "0.0.0.0:1514"
    protocol               = "udp"
    use_incoming_timestamp = true
    labels                 = { job = "pfsense" }
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
